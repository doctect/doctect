# --- Server ---
# Postgres connection string. REQUIRED in production (Cloud Run FS is ephemeral).
# Leave unset for local dev to use server/analytics.db (SQLite).
DATABASE_URL=

# Base URL better-auth uses to construct callback/redirect links.
BETTER_AUTH_URL=http://localhost:3001/api/auth
# Primary client origin (used as a trustedOrigins fallback when TRUSTED_ORIGINS is unset).
CLIENT_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: comma-separated Host headers this server will serve auth for. Unset = allow all (dev).
ALLOWED_HOSTS=
# Sole deployment-controlled owner root of trust. Configure at least two addresses
# in production so another owner can recover authority after account loss.
OWNER_EMAILS=owner@example.com,backup-owner@example.com

# --- Storage limits (all optional; defaults shown) ---
# Per-user cloud storage quota in MB (counts compressed commit bytes).
USER_STORAGE_QUOTA_MB=50
# Hard global ceiling in MB across all users — cost kill-switch. Default 20 GB.
MAX_TOTAL_STORAGE_MB=20480
# Newest commits kept per project; older ones are pruned (open-MR commits always survive).
COMMIT_RETENTION_PER_PROJECT=50
# Max cloud projects per user (forks count).
MAX_PROJECTS_PER_USER=25
# Max simultaneously published (public) projects per user.
MAX_PUBLIC_PROJECTS_PER_USER=20
# Max content-creating writes (project create / save / fork) per user per hour.
USER_COMMITS_PER_HOUR=60

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Tokens (if needed for other features)
DOCTECT_GITHUB_FINE_TOKEN=
DOCTECT_GITHUB_CLASSIC_TOKEN=

# Resend (https://resend.com) API key used by server/email.js to deliver real
# emails (verification links, etc). If unset, server/email.js falls back to
# logging the message (including any verification link) to the server console
# instead of sending it — sign-in blocking for unverified accounts stays
# enforced either way, so an unset key here means real users get locked out
# with only a server-log link to unblock themselves. REQUIRED in production.
RESEND_API_KEY=
# "From" address/name used for outbound email via Resend, e.g.
# "PDF Architect <auth@yourdomain.com>". Defaults to a Resend sandbox address
# if unset.
EMAIL_FROM=

# --- Client (Vite) ---
# Legacy: full base URL used by lib/auth-client.ts (better-auth client) and
# services/analytics.ts. Both currently use this value as-is (not origin-only)
# when set, so in dev each needs its own expected suffix from that file's
# fallback branch (auth-client.ts wants ".../api/auth", analytics.ts wants
# ".../api") — they are NOT interchangeable today. Leave unset in prod.
VITE_API_URL=http://localhost:3001/api/auth
# API origin (no path suffix) used by services/cloudApi.ts for the gallery/
# cloud-projects/fork/merge-request endpoints added in this plan. Leave empty
# in prod (same origin as the client).
VITE_API_BASE=http://localhost:3001

# Verified-account cap: signups close once this many verified accounts exist.
# Empty/unset = 500. 0 = signups closed immediately.
SIGNUP_CAP=
